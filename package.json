{
  "name": "codex-in-chrome",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node packages/extension/build.mjs",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "tsx packages/extension/e2e.ts",
    "test:mcp": "node packages/mcp-server/smoke.mjs && node packages/firefox/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "bridge": "tsx packages/bridge/src/cli.ts serve",
    "mcp": "tsx packages/mcp-server/src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
